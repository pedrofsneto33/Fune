# =============================================================
# EternityOS - Variaveis de ambiente
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA comite .env.local ou .env.production.local no repositorio.
# =============================================================

# ---------- Supabase ----------
# Obtenha em: https://supabase.com/dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key - NUNCA comitar o valor real.
# Esta chave deve ficar APENAS nas variaveis de ambiente da Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- Asaas (Gateway de Pagamento) ----------
# Painel Asaas: https://www.asaas.com
ASAAS_API_KEY=your-asaas-api-key
# URL base da API. Sandbox = https://sandbox.asaas.com/v3 | Producao = https://api.asaas.com/v3
ASAAS_API_URL=https://sandbox.asaas.com/v3
# sandbox ou production
ASAAS_ENVIRONMENT=sandbox
# Segredo HMAC para validar webhooks do Asaas
ASAAS_WEBHOOK_SECRET=your-webhook-secret

# ---------- Agente de Triagem WhatsApp (Evolution API) ----------
# Instale via: https://doc.evolution-api.com/v2/pt/install/docker
# URL do servidor da Evolution (ex: http://127.0.0.1:8080)
EVOLUTION_API_URL=http://your-evolution-server:8080
# Chave global definida no servidor Evolution (variavel AUTHENTICATION_API_KEY)
EVOLUTION_API_KEY=your-evolution-api-key
# Token que a Evolution envia no header do webhook (instala com WEBHOOK_GLOBAL_ENABLED=true)
# Deve ser exatamente o valor configurado em WEBHOOK_GLOBAL_WEBHOOK_PATH ou o secret apontado.
WHATSAPP_WEBHOOK_TOKEN=your-whatsapp-webhook-token

# ---------- Aplicacao ----------
# URL publica (usada para gerar links da carteirinha, webhooks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000